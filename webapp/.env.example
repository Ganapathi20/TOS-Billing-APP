# Postgres connection string. Locally this can point at a local Postgres
# instance; on Vercel, set this to your Neon/Vercel Postgres connection string
# (Project Settings -> Environment Variables).
DATABASE_URL="postgresql://user:password@host:5432/tos_billing"

# Any random string, 32+ characters, used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
