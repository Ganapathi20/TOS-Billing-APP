# Postgres connection strings. Locally these can both point at the same
# plain Postgres instance. On Vercel with the Neon/Vercel Postgres
# integration, DATABASE_URL should be the *pooled* connection string and
# DIRECT_URL the *direct/unpooled* one it also gives you (see webapp/README.md).
DATABASE_URL="postgresql://user:password@host:5432/tos_billing"
DIRECT_URL="postgresql://user:password@host:5432/tos_billing"

# Any random string, 32+ characters, used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Set to "true" to skip OTP login entirely and get a one-click "Switch to
# Resident/Approver view" link instead — useful while testing the app.
# Leave unset (or "false") for any real deployment: this bypasses all
# authentication. See "Testing without login" in webapp/README.md.
SKIP_AUTH="false"
